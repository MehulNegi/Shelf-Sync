{
  "name": "shelfsync-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker:outbox": "node dist/workers/outbox-publisher.js",
    "index:products": "node dist/workers/index-products.js",
    "worker:inventory": "node dist/workers/inventory-consumer.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:kafka": "tsx --test tests/live/kafka.test.ts",
    "test:search": "tsx --test tests/live/search.test.ts",
    "test:pipeline": "tsx --test tests/live/pipeline.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@opensearch-project/opensearch": "^3.10.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
