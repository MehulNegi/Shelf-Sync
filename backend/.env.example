# Copy to backend/.env; replace placeholders with Aiven service credentials.
# URL-encode special characters in the username/password. TLS is always verified.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=verify-full
# Download the project CA from Aiven; never commit it. Relative to backend/.
DATABASE_CA_CERT_PATH=./certs/ca.pem
PORT=3000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Kafka: copy the existing Aiven Quick Connect settings; do not change service auth.
# Use the port for your selected auth method (SASL and mTLS ports differ).
KAFKA_BROKERS=HOST:PORT
KAFKA_CLIENT_ID=shelfsync-outbox
KAFKA_AUTH_MODE=sasl
# Project CA file; omit only if Quick Connect uses a public CA trusted by Node.
KAFKA_CA_CERT_PATH=./certs/kafka-ca.pem
# SASL only: plain, scram-sha-256, or scram-sha-512, matching Quick Connect.
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=YOUR_SERVICE_USER
KAFKA_PASSWORD=YOUR_SERVICE_PASSWORD
# mTLS only: set KAFKA_AUTH_MODE=mtls and provide all three certificate paths.
# KAFKA_CLIENT_CERT_PATH=./certs/service.cert
# KAFKA_CLIENT_KEY_PATH=./certs/service.key
KAFKA_REQUEST_TIMEOUT_MS=10000
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_INITIAL_MS=1000
OUTBOX_RETRY_MAX_MS=30000
