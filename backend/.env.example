# Copy to backend/.env; replace placeholders with Aiven service credentials.
# URL-encode special characters in the username/password. TLS is always verified.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=verify-full
# Download the project CA from Aiven; never commit it. Relative to backend/.
DATABASE_CA_CERT_PATH=./certs/ca.pem
PORT=3000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Kafka: copy the existing Aiven Quick Connect settings; do not change service auth.
# Use the port for your selected auth method (SASL and mTLS ports differ).
KAFKA_BROKERS=HOST:PORT
KAFKA_CLIENT_ID=shelfsync-outbox
KAFKA_AUTH_MODE=sasl
# Project CA file; omit only if Quick Connect uses a public CA trusted by Node.
KAFKA_CA_CERT_PATH=./certs/kafka-ca.pem
# SASL only: plain, scram-sha-256, or scram-sha-512, matching Quick Connect.
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=YOUR_SERVICE_USER
KAFKA_PASSWORD=YOUR_SERVICE_PASSWORD
# mTLS only: set KAFKA_AUTH_MODE=mtls and provide all three certificate paths.
# KAFKA_CLIENT_CERT_PATH=./certs/service.cert
# KAFKA_CLIENT_KEY_PATH=./certs/service.key
KAFKA_REQUEST_TIMEOUT_MS=10000
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_INITIAL_MS=1000
OUTBOX_RETRY_MAX_MS=30000

# Aiven OpenSearch: HTTPS origin and existing service credentials (no URL auth).
# The API uses PostgreSQL search when OPENSEARCH_URL is absent, or on request failure.
OPENSEARCH_URL=https://HOST:PORT
OPENSEARCH_USERNAME=YOUR_SERVICE_USER
OPENSEARCH_PASSWORD=YOUR_SERVICE_PASSWORD
OPENSEARCH_INDEX=shelfsync-products-v1
# Optional for a private/project CA; omit for public CA trusted by Node.
# OPENSEARCH_CA_CERT_PATH=./certs/opensearch-ca.pem
KAFKA_CONSUMER_GROUP_ID=shelfsync-inventory-projection-v1

# Command Center is fail-closed and disabled until explicitly configured.
ADMIN_AUTH_MODE=disabled
# Required for jwt and local-demo: at least 32 random bytes, unpadded base64url.
# Generate locally: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# ADMIN_CURSOR_SECRET=
# Deployed admin access uses an existing trusted identity provider, never Aiven credentials.
# ADMIN_AUTH_MODE=jwt
# ADMIN_JWT_ISSUER=https://identity.example.com/
# ADMIN_JWT_AUDIENCE=shelfsync-admin
# ADMIN_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ADMIN_JWT_ALGORITHMS=RS256
# Only explicit IPs of your trusted TLS reverse proxy; X-Forwarded-Proto from others is ignored.
# ADMIN_HTTPS_PROXY_IPS=127.0.0.1
# Local demonstration only: ADMIN_AUTH_MODE=local-demo, HOST=127.0.0.1,
# NODE_ENV=development, and a loopback FRONTEND_ORIGIN. Never expose it via a tunnel/proxy.

# Smart cart reservations are opt-in. Read docs/reservations.md before rollout.
RESERVATIONS_ENABLED=false
RESERVATION_TTL_SECONDS=30
RESERVATION_ALLOW_LOCAL_HTTP=false
# Required when enabled: dedicated secret, at least 32 random bytes in unpadded base64url.
# RESERVATION_RATE_LIMIT_SECRET=
# Explicit trusted TLS proxy socket peers only; proxy must overwrite forwarding headers.
# RESERVATION_HTTPS_PROXY_IPS=127.0.0.1
# Required when enabled; share this fixed UTC cutoff with publisher and consumer.
# Set the actual rollout timestamp after stopping/draining old schema-v1 writers.
# INVENTORY_V1_CUTOFF_AT=YYYY-MM-DDTHH:mm:ss.sssZ
